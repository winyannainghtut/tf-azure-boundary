#!/usr/bin/env bash
set -euo pipefail

if [ -x /usr/local/bin/boundary ] && [ -f /etc/systemd/system/boundary-worker.service ]; then
  echo "Boundary worker is already installed."
  exit 0
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y jq net-tools unzip curl wget

cd /tmp
download_url="$(curl -fsSL 'https://api.releases.hashicorp.com/v1/releases/boundary/latest?license_class=enterprise' \
  | jq -r '.builds[] | select(.arch == "amd64" and .os == "linux") | .url')"
wget -q "$download_url" -O boundary.zip
unzip -o boundary.zip

id -u boundary >/dev/null 2>&1 || adduser --system --group boundary
install -o boundary -g boundary -m 0755 boundary /usr/local/bin/boundary
mkdir -p /etc/boundary.d/worker

cat > /etc/boundary.d/pki-worker.hcl <<'HCL'
disable_mlock = true
hcp_boundary_cluster_id = "${cluster_id}"

listener "tcp" {
  address = "0.0.0.0:9202"
  purpose = "proxy"
}

worker {
  public_addr       = "${public_addr}"
  auth_storage_path = "/etc/boundary.d/worker"
  tags {
    type = ${worker_type_tags}
  }
}
HCL

chown -R boundary:boundary /etc/boundary.d

cat > /etc/systemd/system/boundary-worker.service <<'UNIT'
[Unit]
Description=Boundary worker
Requires=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/boundary server -config /etc/boundary.d/pki-worker.hcl
User=boundary
Group=boundary
LimitMEMLOCK=infinity
Capabilities=CAP_IPC_LOCK+ep
CapabilityBoundingSet=CAP_SYSLOG CAP_IPC_LOCK
Restart=on-failure

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now boundary-worker.service
